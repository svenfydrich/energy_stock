generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Drink {
  id        Int        @id @default(autoincrement())
  name      String
  brand     String     @default("")
  price     Float
  stock     Int
  imageUrl  String?
  sugarFree Boolean    @default(false)
  purchases Purchase[]
}

model Purchase {
  id           Int      @id @default(autoincrement())
  drink        Drink    @relation(fields: [drinkId], references: [id])
  drinkId      Int
  customerName String?
  createdAt    DateTime @default(now())
}

model WishlistDrink {
  id        Int      @id @default(autoincrement())
  name      String
  brand     String   @default("")
  imageUrl  String?
  sugarFree Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Payment {
  id            Int       @id @default(autoincrement())
  userId        String?   // Optional for now, can be linked to user later
  itemId        Int       // Drink ID
  method        String    // "paypal" or "bank_transfer"
  status        String    // "pending", "pending_bank_transfer", "paid", "failed", "cancelled"
  referenceCode String?   // Unique reference for bank transfers
  paypalOrderId String?   // PayPal order ID
  amount        Float
  customerName  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
